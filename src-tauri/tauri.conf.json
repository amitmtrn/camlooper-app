{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "camlooper",
  "version": "0.2.1",
  "identifier": "com.camlooper.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "camlooper",
        "width": 1200,
        "height": 760,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "CamLooper",
    "homepage": "https://camlooper.com",
    "shortDescription": "Fake webcam that plays any video as a virtual camera",
    "longDescription": "CamLooper is a free fake-webcam app: choose any video or image and it appears as a virtual camera in Zoom, Google Meet, OBS, Discord and other apps. On Debian and Ubuntu it installs and auto-loads v4l2loopback so the virtual camera works out of the box.",
    "targets": ["deb", "rpm", "appimage", "nsis", "msi", "app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "allowDowngrades": true,
      "wix": {
        "language": ["en-US"],
        "template": null
      },
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "languages": ["English"]
      }
    },
    "macOS": {
      "entitlements": "scripts/Entitlements.plist"
    },
    "linux": {
      "deb": {
        "depends": ["v4l2loopback-dkms", "dkms", "ffmpeg"],
        "files": {
          "/etc/modules-load.d/camlooper-v4l2loopback.conf": "linux/modules-load.d/camlooper-v4l2loopback.conf",
          "/etc/modprobe.d/camlooper-v4l2loopback.conf": "linux/modprobe.d/camlooper-v4l2loopback.conf"
        },
        "postInstallScript": "linux/postinst",
        "postRemoveScript": "linux/postrm"
      },
      "rpm": {
        "depends": ["v4l2loopback-dkms", "dkms", "ffmpeg"],
        "files": {
          "/etc/modules-load.d/camlooper-v4l2loopback.conf": "linux/modules-load.d/camlooper-v4l2loopback.conf",
          "/etc/modprobe.d/camlooper-v4l2loopback.conf": "linux/modprobe.d/camlooper-v4l2loopback.conf"
        },
        "postInstallScript": "linux/postinst",
        "postRemoveScript": "linux/postrm"
      }
    }
  }
}
