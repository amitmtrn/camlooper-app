@echo off
echo Registering CamLooper Custom Video Source Filter...

REM Check if running as administrator
net session >nul 2>&1
if %errorLevel% neq 0 (
    echo This script requires administrator privileges.
    echo Please run as administrator.
    pause
    exit /b 1
)

REM Register the filter
regsvr32 /s "@CMAKE_CURRENT_BINARY_DIR@/bin/CustomVideoSource.ax"

if %errorLevel% equ 0 (
    echo Custom Video Source Filter registered successfully!
    echo.
    echo The filter should now appear in DirectShow applications.
    echo You may need to restart applications to see the new camera.
) else (
    echo Failed to register Custom Video Source Filter.
    echo Error code: %errorLevel%
)

pause 