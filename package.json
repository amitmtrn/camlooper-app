{
  "name": "camlooper",
  "private": true,
  "version": "0.2.3",
  "description": "Turn any video into a virtual camera for Zoom, Teams, Meet, OBS and Discord",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://camlooper.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amitmtrn/camlooper-app.git"
  },
  "bugs": {
    "url": "https://github.com/amitmtrn/camlooper-app/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "fetch:win-ffmpeg": "bash scripts/fetch-windows-ffmpeg.sh",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:debug": "tauri build --debug",
    "build:windows": "XWIN_ACCEPT_LICENSE=1 tauri build --runner cargo-xwin --target x86_64-pc-windows-msvc",
    "build:windows:gnu": "tauri build --target x86_64-pc-windows-gnu",
    "build:windows:32": "tauri build --target i686-pc-windows-gnu",
    "build:windows:msvc": "XWIN_ACCEPT_LICENSE=1 tauri build --runner cargo-xwin --target x86_64-pc-windows-msvc",
    "build:windows:msvc:32": "XWIN_ACCEPT_LICENSE=1 tauri build --runner cargo-xwin --target i686-pc-windows-msvc",
    "build:windows:arm": "XWIN_ACCEPT_LICENSE=1 tauri build --runner cargo-xwin --target aarch64-pc-windows-msvc",
    "build:windows:all": "npm run build:windows && npm run build:windows:32",
    "build:windows:debug": "tauri build --debug --target x86_64-pc-windows-gnu",
    "build:exe:windows": "npm run build && cargo build --release --target x86_64-pc-windows-gnu --manifest-path src-tauri/Cargo.toml",
    "build:exe:windows:32": "npm run build && cargo build --release --target i686-pc-windows-gnu --manifest-path src-tauri/Cargo.toml",
    "build:exe:windows:debug": "npm run build && cargo build --target x86_64-pc-windows-gnu --manifest-path src-tauri/Cargo.toml",
    "build:linux": "tauri build --target x86_64-unknown-linux-gnu",
    "build:linux:all": "npm run build:linux",
    "build:linux:debug": "tauri build --debug --target x86_64-unknown-linux-gnu",
    "build:macos": "tauri build --target aarch64-apple-darwin",
    "build:macos:intel": "tauri build --target x86_64-apple-darwin",
    "build:macos:arm64": "tauri build --target aarch64-apple-darwin",
    "build:macos:debug": "tauri build --debug --target aarch64-apple-darwin"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-slider": "^1.2.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@tanstack/react-query": "^5.56.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.462.0",
    "next-themes": "^0.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.11",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@tailwindcss/typography": "^0.5.15",
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "lovable-tagger": "^1.1.7",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^5.4.1"
  }
}
